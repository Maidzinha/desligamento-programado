{
  "name": "desligamento-programado",
  "productName": "Desligamento Programado",
  "version": "1.0.1",
  "description": "Programe o desligamento do seu computador.",
  "main": "main.js",
  "author": "Maidzinha",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maidzinha.desligamento",
    "productName": "Desligamento Programado",
    "win": {
      "target": "portable",
      "icon": "icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Desligamento-Programado.exe"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "art.png",
      "icon.png"
    ],
    "directories": {
      "output": "dist"
    }
  }
}